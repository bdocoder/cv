---
import "../styles/global.css";
import {
  EnvelopeSimpleIcon,
  GithubLogoIcon,
  GlobeIcon,
  LinkedinLogoIcon,
  PhoneIcon,
} from "@phosphor-icons/react";
import Link from "@/components/link.astro";
import Section from "@/components/section.astro";
import Skill from "@/components/skill.astro";
import TimeRange from "@/components/time-range.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Abdullah Ahmad — CV</title>
  </head>
  <body
    class="container max-w-2xl prose prose-hr:mb-6 prose-hr:border-foreground"
  >
    <div class="pt-8">
      <h1 class="mb-0">Abdullah Ahmad</h1>
      <p class="text-xl">Web Developer</p>
      <div>
        <span class="text-link">
          <GlobeIcon className="size-5" />
          <span>Fayyum, Egypt — Available to relocate</span>
        </span>
        <Link
          icon={EnvelopeSimpleIcon}
          href="mailto:bdocoder@gmail.com"
          ariaLabel="email"
        >
          bdocoder@gmail.com
        </Link>
        <Link icon={PhoneIcon} href="tel:+201001004759" ariaLabel="phone">
          +20 100 100 4759
        </Link>
        <Link
          icon={GithubLogoIcon}
          href="https://github.com/bdocoder"
          ariaLabel="github"
        />
        <Link
          icon={LinkedinLogoIcon}
          href="https://linkedin.com/in/bdocoder"
          ariaLabel="linkedin"
        />
      </div>
    </div>

    <Section title="Summary">
      <p>
        I like building web apps that are useful, thoughtful, and easy to use. I
        enjoy turning ideas into working products and learning as I go.
      </p>
    </Section>

    <Section title="Skills">
      <ul>
        <li>
          Soft Skills:
          <Skill>Presentation</Skill>
          /
          <Skill>Time Management</Skill>
        </li>
        <li>
          Programming Languages:
          <Skill>JavaScript</Skill>
          /
          <Skill>Go</Skill>
          /
          <Skill>Java</Skill>
          /
          <Skill>PHP</Skill>
        </li>
        <li>
          Frontend:
          <Skill>React</Skill>
          /
          <Skill>Tailwind CSS</Skill>
        </li>
        <li>
          Backend:
          <Skill>Node.js</Skill>
          /
          <Skill>Next.js</Skill>
          /
          <Skill>Laravel</Skill>
        </li>
        <li>
          Databases:
          <Skill>SQLite</Skill>
          /
          <Skill>SQL Server</Skill>
          /
          <Skill>MongoDB</Skill>
        </li>
        <li>
          Testing:
          <Skill>Selenium</Skill>
          /
          <Skill>Playwright</Skill>
          /
          <Skill>Cypress</Skill>
          /
          <Skill>Postman</Skill>
          /
          <Skill>RestAssured</Skill>
        </li>
        <li>
          Tools/Other:
          <Skill>Linux</Skill>
          /
          <Skill>Git</Skill>
        </li>
      </ul>
    </Section>

    <Section title="Work Experience">
      <TimeRange
        title="QA Engineer at Upscend"
        from="November 2025"
        to="June 2026"
      >
        <ul>
          <li>
            Tested an AI-powered Learning Management System (LMS) through
            end-to-end, manual, and exploratory testing.
          </li>
          <li>
            Designed comprehensive end-to-end test cases covering multiple user
            workflows.
          </li>
          <li>
            Developed a BDD-based automation suite supporting multiple user
            roles and application portals.
          </li>
          <li>
            Collaborated with developers to identify, report, and verify defects
            throughout the development lifecycle.
          </li>
        </ul>
      </TimeRange>
    </Section>

    <Section title="Trainings and Internships">
      <TimeRange
        title="Software Testing at ITI"
        from="March 2025"
        to="August 2025"
      >
        <p>
          Built a solid foundation in software quality, testing workflows, and
          technical communication. Developed the ability to analyze systems,
          design clear test scenarios, and contribute effectively in team-based
          product environments.
        </p>
      </TimeRange>

      <TimeRange
        title="Integration Engineering at TechHub"
        from="September 2024"
        to="November 2024"
      >
        <p>
          Gained practical exposure to backend development and system
          integration, including working with server-side workflows, cloud
          concepts, and enterprise application communication.
        </p>
      </TimeRange>
    </Section>

    <Section title="Projects">
      <div class="space-y-8">
        <TimeRange title="Weather App" from="September 2025" hideTo>
          <p>
            Built an app that displays real-time weather info for selected
            cities (temperature, wind speed, humidity, and precipitation) with
            customizable measurement units and hourly forecasts. It uses
            the Open-Meteo API for accurate data retrieval and is built with
            Tailwind CSS, React, and TanStack Query.
          </p>

          <p>
            Demo: <a href="https://bdocoder-weather-app.vercel.app"
              >https://bdocoder-weather-app.vercel.app</a
            >
          </p>
        </TimeRange>

        <TimeRange
          title="Swag Labs Automation Testing"
          from="July 2025"
          to="August 2025"
        >
          <p>
            Developed end-to-end tests for the Swag Labs demo site using
            Selenium WebDriver and TestNG. Covered workflows like login,
            sorting, cart management, and checkout.
          </p>
        </TimeRange>

        <TimeRange
          title="PocketBase API Testing"
          from="July 2025"
          to="August 2025"
        >
          <p>
            Created and executed API test scenarios for a PocketBase backend
            using Postman and RestAssured. Designed requests for CRUD
            operations, authentication, and edge-case handling. Focused on clean
            structure and reusable test logic.
          </p>
        </TimeRange>
      </div>
    </Section>

    <Section title="Education">
      <TimeRange
        title="College of Science at Fayyum University"
        from="2019"
        to="2023"
      >
        Bachelor's degree in Mathematics and Computer Science. Developed the
        backend of a real estate listing platform as a final project using Deno
        with the Oak framework and MongoDB.
      </TimeRange>
    </Section>

    <Section title="Courses">
      <ul class="font-mono">
        <li>Laravel Essential Training (LinkedIn, July 2025)</li>
        <li>PHP for Beginners (Laracasts, July 2025)</li>
        <li>
          Postman API Testing - Step by Step for Beginners (Udemy Business, July
          2025)
        </li>
        <li>MongoDB NodeJS Developer Path (MongoDB University, August 2024)</li>
        <li>Back-End Web Development with .NET (LinkedIn, August 2024)</li>
      </ul>
    </Section>

    <Section title="Languages">
      <div class="flex gap-2">
        <span>Arabic</span>
        -
        <span>English</span>
      </div>
    </Section>
  </body>
</html>
